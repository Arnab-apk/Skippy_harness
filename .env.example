# ==============================================================================
# Skippy Harness Configuration
# ==============================================================================
# You can provide multiple API keys below and switch between them by setting
# PROVIDER or using the `--provider <name>` flag or the `/provider` command in chat.

# Active Provider: nvidia | openrouter | openai | groq | deepseek | gemini | mistral | together | ollama | custom
PROVIDER=nvidia

# Active Model: (Optional, defaults to the provider's recommended model if left blank)
# MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# Provider API Keys (Fill in the ones you use)
# ------------------------------------------------------------------------------

# 1. NVIDIA NIM (Llama 3.3, Nemotron, DeepSeek R1, Qwen 2.5 Coder)
# Get key at: https://build.nvidia.com/
NVIDIA_API_KEY=

# 2. OpenRouter (Access Claude, GPT-4o, DeepSeek, etc. via one key)
OPENROUTER_API_KEY=

# 3. OpenAI (GPT-4o, GPT-4o-mini, o3-mini, o1)
OPENAI_API_KEY=

# 4. Groq (Ultra-fast Llama 3.3, Qwen 2.5 Coder, DeepSeek R1 Distill)
GROQ_API_KEY=

# 5. DeepSeek (DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=

# 6. Google Gemini (Gemini 2.5 Flash, Gemini 2.5 Pro)
GEMINI_API_KEY=

# 7. Mistral AI (Codestral, Mistral Large)
MISTRAL_API_KEY=

# 8. Together AI (Llama 3.3, Qwen)
TOGETHER_API_KEY=

# 9. Ollama Local (http://localhost:11434/v1)
# OLLAMA_API_KEY=ollama

# 10. Custom OpenAI-compatible Endpoint
# BASE_URL=https://your-custom-endpoint/v1
# API_KEY=your-api-key
